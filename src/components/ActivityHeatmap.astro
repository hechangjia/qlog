---
export interface Props {
  diaryEntries: any[];
  todoItems: any[];
  posts?: any[];
  weeks?: number;
}

const { diaryEntries, todoItems, posts = [], weeks = 52 } = Astro.props;

// Calculate activity data for each day
const today = new Date();
const startDate = new Date(today);
startDate.setDate(today.getDate() - (weeks * 7));

// Create a map of date -> activity count
const activityMap = new Map<string, { diary: number; todo: number; posts: number; total: number }>();

// Initialize all days with zero activity
for (let d = new Date(startDate); d <= today; d.setDate(d.getDate() + 1)) {
  const dateKey = d.toISOString().split('T')[0];
  activityMap.set(dateKey, { diary: 0, todo: 0, posts: 0, total: 0 });
}

// Count diary entries
diaryEntries.forEach(entry => {
  const dateKey = entry.data.date.toISOString().split('T')[0];
  const activity = activityMap.get(dateKey);
  if (activity) {
    activity.diary++;
    activity.total++;
  }
});

// Count todo items
todoItems.forEach(todo => {
  const dateKey = todo.data.date.toISOString().split('T')[0];
  const activity = activityMap.get(dateKey);
  if (activity) {
    activity.todo++;
    activity.total++;
  }
});

// Count posts
posts.forEach(post => {
  const dateKey = post.data.date.toISOString().split('T')[0];
  const activity = activityMap.get(dateKey);
  if (activity) {
    activity.posts++;
    activity.total++;
  }
});

// Convert to array and organize by weeks
const activityArray = Array.from(activityMap.entries()).map(([date, activity]) => ({
  date,
  ...activity
}));

// Group by weeks (starting from Sunday)
const weeks_data: any[][] = [];
let currentWeek: any[] = [];
let currentWeekStart = new Date(startDate);

// Adjust to start from Sunday
const dayOfWeek = currentWeekStart.getDay();
currentWeekStart.setDate(currentWeekStart.getDate() - dayOfWeek);

activityArray.forEach((day, index) => {
  const dayDate = new Date(day.date);
  const weekIndex = Math.floor((dayDate.getTime() - currentWeekStart.getTime()) / (7 * 24 * 60 * 60 * 1000));

  if (!weeks_data[weekIndex]) {
    weeks_data[weekIndex] = Array(7).fill(null);
  }

  const dayIndex = dayDate.getDay();
  weeks_data[weekIndex][dayIndex] = day;
});

// Calculate max activity for color scaling
const maxActivity = Math.max(...activityArray.map(d => d.total), 1);

// Get color based on activity level
function getActivityColor(total: number): string {
  if (total === 0) return 'bg-primary-100 dark:bg-primary-800';
  const intensity = total / maxActivity;
  if (intensity < 0.25) return 'bg-green-200 dark:bg-green-900';
  if (intensity < 0.5) return 'bg-green-400 dark:bg-green-700';
  if (intensity < 0.75) return 'bg-green-600 dark:bg-green-500';
  return 'bg-green-800 dark:bg-green-300';
}

// Month labels
const monthLabels: { month: string; weekIndex: number }[] = [];
let lastMonth = -1;
weeks_data.forEach((week, weekIndex) => {
  if (week[0]) {
    const date = new Date(week[0].date);
    const month = date.getMonth();
    if (month !== lastMonth) {
      monthLabels.push({
        month: date.toLocaleDateString('en-US', { month: 'short' }),
        weekIndex
      });
      lastMonth = month;
    }
  }
});

const dayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
---

<div class="activity-heatmap bg-white dark:bg-primary-800 rounded-xl shadow-lg p-6 border border-primary-200 dark:border-primary-700">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold text-primary-900 dark:text-primary-100">
      📊 Activity Heatmap
    </h2>
    <div class="flex items-center gap-2 text-sm text-primary-600 dark:text-primary-400">
      <span>Less</span>
      <div class="flex gap-1">
        <div class="w-3 h-3 rounded-sm bg-primary-100 dark:bg-primary-800"></div>
        <div class="w-3 h-3 rounded-sm bg-green-200 dark:bg-green-900"></div>
        <div class="w-3 h-3 rounded-sm bg-green-400 dark:bg-green-700"></div>
        <div class="w-3 h-3 rounded-sm bg-green-600 dark:bg-green-500"></div>
        <div class="w-3 h-3 rounded-sm bg-green-800 dark:bg-green-300"></div>
      </div>
      <span>More</span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <div class="inline-block min-w-full">
      <!-- Month labels -->
      <div class="flex mb-2" style="margin-left: 32px;">
        {monthLabels.map(({ month, weekIndex }) => (
          <div
            class="text-xs text-primary-600 dark:text-primary-400"
            style={`margin-left: ${weekIndex * 14}px;`}
          >
            {month}
          </div>
        ))}
      </div>

      <!-- Heatmap grid -->
      <div class="flex">
        <!-- Day labels -->
        <div class="flex flex-col gap-1 mr-2 text-xs text-primary-600 dark:text-primary-400">
          {dayLabels.map((day, index) => (
            <div class="h-3 flex items-center" style={index % 2 === 1 ? '' : 'visibility: hidden;'}>
              {day}
            </div>
          ))}
        </div>

        <!-- Activity squares -->
        <div class="flex gap-1">
          {weeks_data.map((week, weekIndex) => (
            <div class="flex flex-col gap-1">
              {week.map((day, dayIndex) => (
                <div class="relative group">
                  {day ? (
                    <div
                      class={`w-3 h-3 rounded-sm ${getActivityColor(day.total)} transition-all duration-200 hover:ring-2 hover:ring-highlight-500 hover:scale-125 cursor-pointer`}
                      data-date={day.date}
                      data-diary={day.diary}
                      data-todo={day.todo}
                      data-total={day.total}
                    >
                      <!-- Tooltip -->
                      <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-primary-900 dark:bg-primary-100 text-primary-50 dark:text-primary-900 text-xs rounded-lg shadow-lg opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-50">
                        <div class="font-semibold mb-1">
                          {new Date(day.date).toLocaleDateString('en-US', {
                            weekday: 'short',
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                          })}
                        </div>
                        <div class="text-xs space-y-1">
                          <div>📖 {day.posts} {day.posts === 1 ? 'post' : 'posts'}</div>
                          <div>📝 {day.diary} {day.diary === 1 ? 'diary entry' : 'diary entries'}</div>
                          <div>✅ {day.todo} {day.todo === 1 ? 'todo' : 'todos'}</div>
                          <div class="font-semibold border-t border-primary-700 dark:border-primary-300 pt-1 mt-1">
                            Total: {day.total} {day.total === 1 ? 'activity' : 'activities'}
                          </div>
                        </div>
                        <!-- Tooltip arrow -->
                        <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-primary-900 dark:border-t-primary-100"></div>
                      </div>
                    </div>
                  ) : (
                    <div class="w-3 h-3 rounded-sm bg-primary-50 dark:bg-primary-900"></div>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Statistics summary -->
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="text-center p-3 bg-primary-50 dark:bg-primary-900 rounded-lg">
          <div class="text-2xl font-bold text-primary-900 dark:text-primary-100">
            {activityArray.reduce((sum, day) => sum + day.total, 0)}
          </div>
          <div class="text-xs text-primary-600 dark:text-primary-400">Total Activities</div>
        </div>
        <div class="text-center p-3 bg-primary-50 dark:bg-primary-900 rounded-lg">
          <div class="text-2xl font-bold text-primary-900 dark:text-primary-100">
            {activityArray.filter(day => day.total > 0).length}
          </div>
          <div class="text-xs text-primary-600 dark:text-primary-400">Active Days</div>
        </div>
        <div class="text-center p-3 bg-primary-50 dark:bg-primary-900 rounded-lg">
          <div class="text-2xl font-bold text-primary-900 dark:text-primary-100">
            {maxActivity}
          </div>
          <div class="text-xs text-primary-600 dark:text-primary-400">Max Day</div>
        </div>
        <div class="text-center p-3 bg-primary-50 dark:bg-primary-900 rounded-lg">
          <div class="text-2xl font-bold text-primary-900 dark:text-primary-100">
            {Math.round(activityArray.reduce((sum, day) => sum + day.total, 0) / activityArray.length * 10) / 10}
          </div>
          <div class="text-xs text-primary-600 dark:text-primary-400">Daily Average</div>
        </div>
      </div>

      <!-- Longest streak -->
      {(() => {
        let currentStreak = 0;
        let maxStreak = 0;
        let currentStreakStart = '';
        let maxStreakStart = '';
        let maxStreakEnd = '';

        activityArray.forEach((day, index) => {
          if (day.total > 0) {
            if (currentStreak === 0) {
              currentStreakStart = day.date;
            }
            currentStreak++;
            if (currentStreak > maxStreak) {
              maxStreak = currentStreak;
              maxStreakStart = currentStreakStart;
              maxStreakEnd = day.date;
            }
          } else {
            currentStreak = 0;
          }
        });

        return maxStreak > 0 ? (
          <div class="mt-4 p-4 bg-highlight-50 dark:bg-highlight-900/20 rounded-lg border border-highlight-200 dark:border-highlight-700">
            <div class="flex items-center justify-between">
              <div>
                <div class="text-sm font-medium text-primary-700 dark:text-primary-300 mb-1">
                  🔥 Longest Streak
                </div>
                <div class="text-2xl font-bold text-highlight-600 dark:text-highlight-400">
                  {maxStreak} {maxStreak === 1 ? 'day' : 'days'}
                </div>
              </div>
              <div class="text-right text-xs text-primary-600 dark:text-primary-400">
                <div>{new Date(maxStreakStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
                <div>to</div>
                <div>{new Date(maxStreakEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
              </div>
            </div>
          </div>
        ) : null;
      })()}
    </div>
  </div>
</div>

<style>
  .activity-heatmap {
    position: relative;
  }

  /* Ensure tooltips are visible */
  .activity-heatmap :global(.group:hover) {
    z-index: 100;
  }
</style>
