---
export interface Props {
  diaryEntries: any[];
  todoItems: any[];
  posts?: any[];
  months?: number;
}

const { diaryEntries, todoItems, posts = [], months = 12 } = Astro.props;

// Calculate monthly trends
const today = new Date();
const monthlyData: {
  month: string;
  year: number;
  postsCount: number;
  diaryCount: number;
  todoCount: number;
  completedTodos: number;
}[] = [];

for (let i = months - 1; i >= 0; i--) {
  const date = new Date(today.getFullYear(), today.getMonth() - i, 1);
  const nextMonth = new Date(today.getFullYear(), today.getMonth() - i + 1, 1);

  const postsCount = posts.filter(post => {
    const postDate = post.data.date;
    return postDate >= date && postDate < nextMonth;
  }).length;

  const diaryCount = diaryEntries.filter(entry => {
    const entryDate = entry.data.date;
    return entryDate >= date && entryDate < nextMonth;
  }).length;

  const monthTodos = todoItems.filter(todo => {
    const todoDate = todo.data.date;
    return todoDate >= date && todoDate < nextMonth;
  });

  const todoCount = monthTodos.length;
  const completedTodos = monthTodos.filter(todo => todo.data.status === 'done').length;

  monthlyData.push({
    month: date.toLocaleDateString('en-US', { month: 'short' }),
    year: date.getFullYear(),
    postsCount,
    diaryCount,
    todoCount,
    completedTodos
  });
}

// Calculate max values for scaling
const maxPosts = Math.max(...monthlyData.map(m => m.postsCount), 1);
const maxDiary = Math.max(...monthlyData.map(m => m.diaryCount), 1);
const maxTodo = Math.max(...monthlyData.map(m => m.todoCount), 1);
const maxValue = Math.max(maxPosts, maxDiary, maxTodo);
---

<div class="monthly-trends bg-white dark:bg-primary-800 rounded-xl shadow-lg p-6 border border-primary-200 dark:border-primary-700">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-bold text-primary-900 dark:text-primary-100">
      📈 Monthly Trends
    </h2>
    <div class="flex items-center gap-4 text-sm">
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-indigo-500"></div>
        <span class="text-primary-600 dark:text-primary-400">Posts</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-blue-500"></div>
        <span class="text-primary-600 dark:text-primary-400">Diary</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-green-500"></div>
        <span class="text-primary-600 dark:text-primary-400">Todos</span>
      </div>
    </div>
  </div>

  <!-- Chart -->
  <div class="relative">
    <!-- Y-axis labels -->
    <div class="absolute left-0 top-0 bottom-12 flex flex-col justify-between text-xs text-primary-600 dark:text-primary-400 pr-2">
      <span>{maxValue}</span>
      <span>{Math.round(maxValue * 0.75)}</span>
      <span>{Math.round(maxValue * 0.5)}</span>
      <span>{Math.round(maxValue * 0.25)}</span>
      <span>0</span>
    </div>

    <!-- Chart area -->
    <div class="ml-8 pl-4 border-l border-b border-primary-200 dark:border-primary-700">
      <div class="flex items-end justify-between h-64 gap-2">
        {monthlyData.map((data, index) => (
          <div class="flex-1 flex flex-col items-center gap-2 group">
            <!-- Bars -->
            <div class="w-full flex justify-center items-end gap-1 h-full relative">
              <!-- Posts bar -->
              <div
                class="flex-1 bg-indigo-500 dark:bg-indigo-400 rounded-t-lg transition-all duration-300 hover:bg-indigo-600 dark:hover:bg-indigo-300 relative group/bar"
                style={`height: ${(data.postsCount / maxValue) * 100}%;`}
              >
                <!-- Tooltip for posts -->
                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-primary-900 dark:bg-primary-100 text-primary-50 dark:text-primary-900 text-xs rounded-lg shadow-lg opacity-0 group-hover/bar:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-50">
                  <div class="font-semibold">📖 Posts</div>
                  <div>{data.postsCount} {data.postsCount === 1 ? 'post' : 'posts'}</div>
                  <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-primary-900 dark:border-t-primary-100"></div>
                </div>
              </div>

              <!-- Diary bar -->
              <div
                class="flex-1 bg-blue-500 dark:bg-blue-400 rounded-t-lg transition-all duration-300 hover:bg-blue-600 dark:hover:bg-blue-300 relative group/bar"
                style={`height: ${(data.diaryCount / maxValue) * 100}%;`}
              >
                <!-- Tooltip for diary -->
                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-primary-900 dark:bg-primary-100 text-primary-50 dark:text-primary-900 text-xs rounded-lg shadow-lg opacity-0 group-hover/bar:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-50">
                  <div class="font-semibold">📝 Diary</div>
                  <div>{data.diaryCount} {data.diaryCount === 1 ? 'entry' : 'entries'}</div>
                  <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-primary-900 dark:border-t-primary-100"></div>
                </div>
              </div>

              <!-- Todo bar -->
              <div
                class="flex-1 bg-green-500 dark:bg-green-400 rounded-t-lg transition-all duration-300 hover:bg-green-600 dark:hover:bg-green-300 relative group/bar"
                style={`height: ${(data.todoCount / maxValue) * 100}%;`}
              >
                <!-- Tooltip for todos -->
                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-primary-900 dark:bg-primary-100 text-primary-50 dark:text-primary-900 text-xs rounded-lg shadow-lg opacity-0 group-hover/bar:opacity-100 pointer-events-none transition-opacity duration-200 whitespace-nowrap z-50">
                  <div class="font-semibold">✅ Todos</div>
                  <div>{data.todoCount} total</div>
                  <div>{data.completedTodos} completed</div>
                  <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-primary-900 dark:border-t-primary-100"></div>
                </div>
              </div>
            </div>

            <!-- Month label -->
            <div class="text-xs text-primary-600 dark:text-primary-400 text-center mt-2">
              <div class="font-medium">{data.month}</div>
              {index === 0 || data.month === 'Jan' ? (
                <div class="text-[10px] opacity-75">{data.year}</div>
              ) : null}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Summary statistics -->
  <div class="mt-6 grid grid-cols-4 gap-4">
    <div class="text-center p-3 bg-indigo-50 dark:bg-indigo-900/20 rounded-lg">
      <div class="text-lg font-bold text-indigo-600 dark:text-indigo-400">
        {monthlyData.reduce((sum, m) => sum + m.postsCount, 0)}
      </div>
      <div class="text-xs text-primary-600 dark:text-primary-400">Total Posts</div>
    </div>
    <div class="text-center p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
      <div class="text-lg font-bold text-blue-600 dark:text-blue-400">
        {monthlyData.reduce((sum, m) => sum + m.diaryCount, 0)}
      </div>
      <div class="text-xs text-primary-600 dark:text-primary-400">Total Diary Entries</div>
    </div>
    <div class="text-center p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
      <div class="text-lg font-bold text-green-600 dark:text-green-400">
        {monthlyData.reduce((sum, m) => sum + m.todoCount, 0)}
      </div>
      <div class="text-xs text-primary-600 dark:text-primary-400">Total Todos</div>
    </div>
    <div class="text-center p-3 bg-purple-50 dark:bg-purple-900/20 rounded-lg">
      <div class="text-lg font-bold text-purple-600 dark:text-purple-400">
        {monthlyData.reduce((sum, m) => sum + m.completedTodos, 0)}
      </div>
      <div class="text-xs text-primary-600 dark:text-primary-400">Completed Todos</div>
    </div>
  </div>

  <!-- Best month -->
  {(() => {
    const bestMonth = monthlyData.reduce((best, current) => {
      const currentTotal = current.postsCount + current.diaryCount + current.todoCount;
      const bestTotal = best.postsCount + best.diaryCount + best.todoCount;
      return currentTotal > bestTotal ? current : best;
    }, monthlyData[0]);

    return (
      <div class="mt-4 p-4 bg-highlight-50 dark:bg-highlight-900/20 rounded-lg border border-highlight-200 dark:border-highlight-700">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-sm font-medium text-primary-700 dark:text-primary-300 mb-1">
              🏆 Most Productive Month
            </div>
            <div class="text-2xl font-bold text-highlight-600 dark:text-highlight-400">
              {bestMonth.month} {bestMonth.year}
            </div>
          </div>
          <div class="text-right">
            <div class="text-sm text-primary-600 dark:text-primary-400">
              {bestMonth.postsCount} posts · {bestMonth.diaryCount} diary · {bestMonth.todoCount} todos
            </div>
            <div class="text-xs text-primary-500 dark:text-primary-500">
              Total: {bestMonth.postsCount + bestMonth.diaryCount + bestMonth.todoCount} activities
            </div>
          </div>
        </div>
      </div>
    );
  })()}
</div>

<style>
  .monthly-trends {
    position: relative;
  }
</style>
