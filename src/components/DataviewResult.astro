---
// Component that executes Dataview queries and displays results
import type { CollectionEntry } from 'astro:content';
import { executeDataviewQuery, formatFieldValue, getFieldDisplayName } from '@/utils/dataview';

interface Props {
  title?: string;
  description?: string;
  query: string;
  collections: {
    diary?: CollectionEntry<'diary'>[];
    todo?: CollectionEntry<'todo'>[];
    posts?: CollectionEntry<'posts'>[];
    docs?: CollectionEntry<'docs'>[];
    projects?: CollectionEntry<'projects'>[];
  };
}

const { title, description, query, collections } = Astro.props;

// Execute the query
const result = await executeDataviewQuery(query, collections);
---

<div class="dataview-result-card">
  {title && <h3 class="result-title">{title}</h3>}
  {description && <p class="result-description">{description}</p>}

  <div class="result-container">
    {result.type === 'TABLE' && !result.grouped && (
      <div class="table-container">
        <table class="result-table">
          <thead>
            <tr>
              {!result.withoutId && <th>标题</th>}
              {result.fields?.map(field => (
                <th>{getFieldDisplayName(field)}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {result.items.length > 0 ? (
              result.items.map((item: any) => (
                <tr>
                  {!result.withoutId && (
                    <td>
                      <a href={`/${item.collection}/${item.id}`} class="item-link">
                        {item.data.title || item.id}
                      </a>
                    </td>
                  )}
                  {result.fields?.map(field => (
                    // 使用 set:html 来渲染 HTML 内容（如链接、进度条）
                    <td set:html={formatFieldValue(item, field)}></td>
                  ))}
                </tr>
              ))
            ) : (
              <tr>
                <td colspan={(result.fields ? result.fields.length : 0) + (result.withoutId ? 0 : 1)} class="no-results">
                  暂无数据
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    )}

    {result.type === 'TABLE' && result.grouped && (
      <div class="grouped-container">
        {Object.entries(result.grouped).map(([group, items]: [string, any[]]) => (
          <div class="group-section">
            <h4 class="group-title">{group} <span class="text-xs font-normal opacity-60">({items.length})</span></h4>
            <div class="table-container">
                <table class="result-table">
                <thead>
                    <tr>
                    {!result.withoutId && <th>标题</th>}
                    {result.fields?.map(field => (
                        <th>{getFieldDisplayName(field)}</th>
                    ))}
                    </tr>
                </thead>
                <tbody>
                    {items.map((item: any) => (
                    <tr>
                        {!result.withoutId && (
                            <td>
                            <a href={`/${item.collection}/${item.id}`} class="item-link">
                                {item.data.title}
                            </a>
                            </td>
                        )}
                        {result.fields?.map(field => (
                        <td set:html={formatFieldValue(item, field)}></td>
                        ))}
                    </tr>
                    ))}
                </tbody>
                </table>
            </div>
          </div>
        ))}
      </div>
    )}

    {result.type === 'LIST' && (
      <div class="list-container">
          <ul class="result-list">
            {result.items.length > 0 ? (
            result.items.map((item: any) => (
                <li class="list-item">
                <a href={`/${item.collection}/${item.id}`} class="item-link">
                    {item.data.title}
                </a>
                </li>
            ))
            ) : (
            <li class="no-results">暂无数据</li>
            )}
        </ul>
      </div>
    )}
  </div>
  
  <details class="query-details mt-2">
      <summary class="query-summary">查看查询语句</summary>
      <pre class="query-code"><code>{query.trim()}</code></pre>
  </details>
</div>

<style>
  .dataview-result-card {
    background: var(--color-surface-secondary, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 1rem 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  :global(.dark) .dataview-result-card {
      background: #1f2937;
      border-color: #374151;
  }

  .result-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-heading, #111827);
  }
  :global(.dark) .result-title { color: #f3f4f6; }

  .result-description {
    margin: 0 0 1rem 0;
    font-size: 0.875rem;
    color: var(--color-text-muted, #6b7280);
  }

  .result-container {
    background: var(--color-surface-tertiary, #f9fafb);
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border, #e5e7eb);
  }
  :global(.dark) .result-container { 
      background: #111827; 
      border-color: #374151;
  }

  /* Table Styles - Fixed Alignment */
  .table-container {
    overflow-x: auto;
    width: 100%;
  }

  .result-table {
    width: 100%;
    border-collapse: collapse; /* 关键：合并边框 */
    font-size: 0.875rem;
    white-space: nowrap; /* 关键：防止换行导致的错位 */
  }

  .result-table th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    background: var(--color-surface-secondary, #f3f4f6);
    color: var(--color-text-heading, #374151);
    border-bottom: 2px solid var(--color-border, #e5e7eb);
  }
  :global(.dark) .result-table th { background: #374151; color: #e5e7eb; border-color: #4b5563; }

  .result-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-text-body, #4b5563);
  }
  :global(.dark) .result-table td { border-color: #374151; color: #d1d5db; }

  .result-table tbody tr:last-child td { border-bottom: none; }
  .result-table tbody tr:hover {
    background: rgba(0,0,0,0.02);
  }
  :global(.dark) .result-table tbody tr:hover { background: rgba(255,255,255,0.05); }

  .item-link {
    color: #4f46e5; /* Indigo-600 */
    text-decoration: none;
    font-weight: 500;
  }
  :global(.dark) .item-link { color: #818cf8; }
  .item-link:hover { text-decoration: underline; }

  .group-section { padding: 1rem; }
  .group-title { 
      font-size: 1rem; 
      font-weight: 700; 
      margin-bottom: 0.5rem; 
      color: #4b5563;
      border-left: 4px solid #6366f1;
      padding-left: 0.5rem;
  }
  :global(.dark) .group-title { color: #e5e7eb; }

  /* Query details */
  .query-summary {
      font-size: 0.75rem;
      color: #9ca3af;
      cursor: pointer;
      margin-top: 0.5rem;
  }
  .query-code {
      margin-top: 0.5rem;
      padding: 0.5rem;
      background: #1f2937;
      color: #10b981;
      border-radius: 0.375rem;
      font-size: 0.75rem;
      overflow-x: auto;
  }
</style>