---
import type { Todo } from '@/types';
import { calculateReadingTime, formatDate, formatDateMobile } from '@/utils/markdown';
import { optimizePostImagePath } from '@/utils/images';
import ImageWrapper from './ImageWrapper.astro';

export interface Props {
  todo: Todo;
  eager?: boolean;
}

const { todo, eager = false } = Astro.props;
const readingTime = calculateReadingTime(todo.body || '');
---

<article class={`group relative border border-primary-200 dark:border-primary-700 rounded-lg bg-primary-50 dark:bg-primary-900 overflow-hidden hover:border-highlight-300 dark:hover:border-highlight-600 transition-all duration-300 ${todo.data.status === 'done' ? 'opacity-75' : ''} ${
  todo.data.priority === 'high' ? 'border-l-4 border-red-500' :
  todo.data.priority === 'medium' ? 'border-l-4 border-yellow-500' :
  todo.data.priority === 'low' ? 'border-l-4 border-green-500' : ''
}`}>
  <!-- Status indicator -->
  {todo.data.status && (
    <div class="absolute top-4 right-4 z-10">
      <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium ${
        todo.data.status === 'done' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
        todo.data.status === 'in-progress' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' :
        todo.data.status === 'todo' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
        'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200'
      }`}>
        {todo.data.status}
      </span>
    </div>
  )}

  <!-- Cover image -->
  {todo.data.image && (
    <div class="h-48 overflow-hidden bg-primary-100 dark:bg-primary-800">
      <ImageWrapper
        src={todo.data.image}
        alt={todo.data.imageAlt || `Cover image for todo: ${todo.data.title}`}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        width={800}
        height={400}
        format="webp"
        quality={85}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
    </div>
  )}

  <!-- Content -->
  <div class="p-6">
    <!-- Date and reading time -->
    <div class="flex items-center text-sm text-primary-600 dark:text-primary-400 mb-3">
      <time datetime={todo.data.date.toISOString()}>
        <span class="hidden sm:inline">{formatDate(todo.data.date)}</span>
        <span class="sm:hidden">{formatDateMobile(todo.data.date)}</span>
      </time>
      {todo.data.dueDate && (
        <>
          <span class="mx-2">•</span>
          <time datetime={todo.data.dueDate.toISOString()}>
            <span class={`font-medium ${todo.data.dueDate < new Date() && todo.data.status !== 'done' ? 'text-red-600 dark:text-red-400' : ''}`}>
              Due: {todo.data.dueDate.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
            </span>
          </time>
        </>
      )}
      <span class="mx-2">•</span>
      <span>{readingTime.text}</span>
    </div>

    <!-- Title -->
    <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100 mb-3 group-hover:text-highlight-600 dark:group-hover:text-highlight-400 transition-colors">
      <a href={`/todo/${todo.id}`} class="block">
        {todo.data.title}
      </a>
    </h2>

    <!-- Description -->
    {todo.data.description && (
      <p class="text-primary-700 dark:text-primary-300 mb-4">
        {todo.data.description}
      </p>
    )}

    <!-- Tags and metadata -->
    <div class="flex flex-wrap items-center gap-4 mb-4">
      <!-- Tags -->
      {todo.data.tags && todo.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {todo.data.tags.map(tag => (
            <a
              href={`/todo?tag=${encodeURIComponent(tag)}`}
              class="text-xs text-primary-600 dark:text-primary-300 bg-primary-100 dark:bg-primary-800 px-2.5 py-1 rounded-full border border-primary-200 dark:border-primary-700 transition-colors hover:bg-highlight-100 dark:hover:bg-highlight-800"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Additional metadata -->
    <div class="flex flex-wrap items-center gap-4 text-sm text-primary-600 dark:text-primary-400">
      <!-- Category -->
      {todo.data.category && (
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <span>{todo.data.category}</span>
        </div>
      )}

      <!-- Priority -->
      {todo.data.priority && (
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
          <span>{todo.data.priority} priority</span>
        </div>
      )}

      <!-- Estimated time -->
      {todo.data.estimatedTime && (
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{todo.data.estimatedTime}</span>
        </div>
      )}

      <!-- Assigned to -->
      {todo.data.assignedTo && (
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>{todo.data.assignedTo}</span>
        </div>
      )}
    </div>

    <!-- Progress indicator -->
    {todo.data.progress !== undefined && todo.data.progress !== null && (
      <div class="mt-4">
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm font-medium text-primary-700 dark:text-primary-300">Progress</span>
          <span class="text-sm font-medium text-primary-600 dark:text-primary-400">{todo.data.progress}%</span>
        </div>
        <div class="w-full bg-primary-200 dark:bg-primary-700 rounded-full h-2">
          <div
            class="bg-highlight-500 dark:bg-highlight-400 h-2 rounded-full transition-all duration-300"
            style={`width: ${todo.data.progress}%`}
          ></div>
        </div>
      </div>
    )}
  </div>
</article>
