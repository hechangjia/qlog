---
import type { Todo } from "@/types";
import { getAdjacentItems } from "@/utils/markdown";
import { generateContentSEO } from "@/utils/seo";
import BaseLayout from "./BaseLayout.astro";
import Tags from "@/components/Tags.astro";
import { getCollection, render } from "astro:content";

const { todo: todoEntry, siteConfig } = Astro.props;
const todo = todoEntry as Todo;

// Get all todos for navigation
const allTodos = await getCollection("todo");
const adjacentTodos = getAdjacentItems(allTodos, todo.id);

// Generate SEO data
const seoData = generateContentSEO(todo, `/todo/${todo.id}`, 'todo');

// Render the todo content
const { Content } = await render(todo);
---

<BaseLayout seoData={seoData}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Todo header -->
    <header class="mb-8">
      <!-- Date and status -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <time
          datetime={todo.data.date.toISOString()}
          class="text-sm text-primary-600 dark:text-primary-400"
        >
          {todo.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        
        <!-- Priority badge -->
        {todo.data.priority && (
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
            todo.data.priority === 'high' 
              ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' 
              : todo.data.priority === 'medium'
              ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
              : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
          }`}>
            {todo.data.priority} priority
          </span>
        )}
        
        <!-- Status badge -->
        {todo.data.status && (
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
            todo.data.status === 'done' 
              ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
              : todo.data.status === 'in-progress'
              ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
              : 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200'
          }`}>
            {todo.data.status}
          </span>
        )}
      </div>

      <!-- Title -->
      <h1 class="text-4xl font-bold text-primary-900 dark:text-primary-100 mb-4">
        {todo.data.title}
      </h1>

      <!-- Description -->
      {todo.data.description && (
        <p class="text-xl text-primary-700 dark:text-primary-300 mb-6">
          {todo.data.description}
        </p>
      )}

      <!-- Metadata -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-primary-600 dark:text-primary-400">
        <!-- Category -->
        {todo.data.category && (
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span>{todo.data.category}</span>
          </div>
        )}

        <!-- Due date -->
        {todo.data.dueDate && (
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>Due: {todo.data.dueDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
          </div>
        )}

        <!-- Estimated time -->
        {todo.data.estimatedTime && (
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>{todo.data.estimatedTime}</span>
          </div>
        )}
      </div>

      <!-- Tags -->
      {todo.data.tags && todo.data.tags.length > 0 && (
        <div class="mt-4">
          <Tags tags={todo.data.tags} />
        </div>
      )}
    </header>

    <!-- Cover image -->
    {todo.data.image && !todo.data.hideCoverImage && (
      <figure class="mb-8">
        <img
          src={todo.data.image}
          alt={todo.data.imageAlt || `Cover image for todo: ${todo.data.title}`}
          class="w-full h-auto rounded-lg shadow-md"
        />
        {todo.data.imageAlt && (
          <figcaption class="mt-2 text-sm text-center text-primary-600 dark:text-primary-400">
            {todo.data.imageAlt}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Todo content -->
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <Content />
    </div>

    <!-- Additional metadata -->
    {(todo.data.dependencies && todo.data.dependencies.length > 0) || todo.data.assignedTo || todo.data.notes ? (
      <div class="mt-8 p-6 bg-primary-50 dark:bg-primary-800 rounded-lg">
        <h3 class="text-lg font-semibold text-primary-900 dark:text-primary-100 mb-4">
          Additional Details
        </h3>
        
        <div class="grid gap-4">
          {/* Dependencies */}
          {todo.data.dependencies && todo.data.dependencies.length > 0 && (
            <div>
              <h4 class="text-sm font-medium text-primary-700 dark:text-primary-300 mb-1">
                Dependencies
              </h4>
              <ul class="list-disc list-inside text-sm text-primary-600 dark:text-primary-400">
                {todo.data.dependencies.map((dep: string) => (
                  <li>{dep}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Assigned to */}
          {todo.data.assignedTo && (
            <div>
              <h4 class="text-sm font-medium text-primary-700 dark:text-primary-300 mb-1">
                Assigned To
              </h4>
              <p class="text-sm text-primary-600 dark:text-primary-400">
                {todo.data.assignedTo}
              </p>
            </div>
          )}

          {/* Notes */}
          {todo.data.notes && (
            <div>
              <h4 class="text-sm font-medium text-primary-700 dark:text-primary-300 mb-1">
                Notes
              </h4>
              <p class="text-sm text-primary-600 dark:text-primary-400">
                {todo.data.notes}
              </p>
            </div>
          )}
        </div>
      </div>
    ) : null}

    <!-- Navigation -->
    {(adjacentTodos.prev || adjacentTodos.next) && (
      <div class="mt-12 pt-8 border-t border-primary-200 dark:border-primary-700">
        <div class="flex justify-between items-center">
          {adjacentTodos.prev ? (
            <a
              href={`/todo/${adjacentTodos.prev.id}`}
              class="group flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-100"
            >
              <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              <div class="flex flex-col">
                <span class="text-sm font-medium">Previous Todo</span>
                <span class="text-lg font-semibold">{adjacentTodos.prev.data.title}</span>
              </div>
            </a>
          ) : (
            <div></div>
          )}

          {adjacentTodos.next ? (
            <a
              href={`/todo/${adjacentTodos.next.id}`}
              class="group flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-100 text-right"
            >
              <div class="flex flex-col">
                <span class="text-sm font-medium">Next Todo</span>
                <span class="text-lg font-semibold">{adjacentTodos.next.data.title}</span>
              </div>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          ) : (
            <div></div>
          )}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
