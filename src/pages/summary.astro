---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config';
import { getCollection } from 'astro:content';

const pageTitle = '生活总结 & AI 绘图 | Life Summary';
const pageDescription = '生成你的专属生活回顾，支持 Apple Music 风格总结卡片';

const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: pageDescription,
  canonical: Astro.url.href,
  ogType: 'website' as const
};

// --- Server-Side Data Fetching ---
// 获取数据并过滤草稿
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const allDiary = await getCollection('diary', ({ data }) => !data.draft);
const allTodo = await getCollection('todo', ({ data }) => !data.draft);
let allSlides = [];
try { allSlides = await getCollection('slides', ({ data }) => !data.draft); } catch (e) {}

// 数据标准化
function normalizeContent(items, type, label) {
    return items.map(item => {
        const data = item.data;
        const date = data.date || data.publishDate || data.createdAt || new Date();
        const wordCount = item.body ? item.body.length : (data.description?.length || 0);
        
        return {
            type, // 用于逻辑过滤 (post, diary...)
            typeLabel: label, // 用于 Prompt 显示 (文章, 日记...)
            title: data.title || item.id,
            date: new Date(date).toISOString(),
            tags: data.tags || [],
            status: data.status || 'unknown',
            mood: data.mood || 'neutral',
            wordCount: wordCount,
            summary: (data.description || item.body || "").substring(0, 200).replace(/[\r\n#*]/g, ' ').trim()
        };
    });
}

// 合并数据
const rawData = [
    ...normalizeContent(allPosts, 'post', '文章'),
    ...normalizeContent(allDiary, 'diary', '日记'),
    ...normalizeContent(allTodo, 'todo', '待办'),
    ...normalizeContent(allSlides, 'slide', '幻灯片')
];

const serializedData = JSON.stringify(rawData);
---

<BaseLayout seoData={seoData}>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 via-gray-100 to-gray-200 dark:from-gray-900 dark:via-gray-800 dark:to-black">
    <div class="container mx-auto px-4 py-12">
      <header class="text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500 dark:from-pink-400 dark:via-red-400 dark:to-yellow-400 mb-6 tracking-tight">
          🎵 时光·听见·生活
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto font-light">
          生成 Apple Music 风格的年度生活回顾卡片
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-7xl mx-auto">
        
        <div class="space-y-8">
            <div class="bg-white dark:bg-gray-800/80 backdrop-blur-xl rounded-3xl shadow-2xl p-8 border border-white/20">
                <div class="flex items-center gap-3 mb-6 border-b border-gray-100 dark:border-gray-700 pb-4">
                    <span class="text-2xl">📝</span>
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                        时光采样配置
                    </h2>
                </div>
                
                <div class="space-y-6">
                    <div class="p-5 bg-gray-50 dark:bg-black/30 rounded-2xl border border-gray-100 dark:border-gray-700">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">AI 文本模型 (DeepSeek/OpenAI)</h3>
                        </div>
                        <div class="space-y-3">
                            <div>
                                <input type="text" id="llm-base-url" class="config-input text-xs" placeholder="Base URL (e.g. https://api.deepseek.com)" value="https://api.deepseek.com" />
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <input type="password" id="llm-api-key" class="config-input text-xs" placeholder="API Key (sk-...)" />
                                <input type="text" id="llm-model-name" class="config-input text-xs" placeholder="Model (deepseek-chat)" value="deepseek-chat" />
                            </div>
                        </div>
                    </div>

                    <div class="space-y-5">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-wider">1. 选择时间跨度</label>
                            <div class="grid grid-cols-4 gap-2">
                                <button onclick="selectPeriod('week')" id="btn-week" class="period-btn active">本周</button>
                                <button onclick="selectPeriod('month')" id="btn-month" class="period-btn">本月</button>
                                <button onclick="selectPeriod('year')" id="btn-year" class="period-btn">年度</button>
                                <button onclick="selectPeriod('custom')" id="btn-custom" class="period-btn">自定义</button>
                            </div>
                            <div id="custom-days-input" class="hidden mt-3 flex items-center gap-3 animate-fade-in">
                                <span class="text-sm text-gray-600 dark:text-gray-400">最近</span>
                                <input type="number" id="n-days" value="30" min="1" max="999" class="w-20 text-center border rounded-lg px-2 py-1 dark:bg-gray-700 dark:border-gray-600" onchange="updateFilteredCount()" />
                                <span class="text-sm text-gray-600 dark:text-gray-400">天</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-2 tracking-wider">2. 自定义总结内容</label>
                            <div class="flex flex-wrap gap-2">
                                <label class="filter-chip">
                                    <input type="checkbox" checked value="post" class="content-type-cb hidden" onchange="updateFilteredCount()">
                                    <span class="chip-label">文章 Posts</span>
                                </label>
                                <label class="filter-chip">
                                    <input type="checkbox" checked value="diary" class="content-type-cb hidden" onchange="updateFilteredCount()">
                                    <span class="chip-label">日记 Diary</span>
                                </label>
                                <label class="filter-chip">
                                    <input type="checkbox" checked value="todo" class="content-type-cb hidden" onchange="updateFilteredCount()">
                                    <span class="chip-label">待办 Todo</span>
                                </label>
                                <label class="filter-chip">
                                    <input type="checkbox" value="slide" class="content-type-cb hidden" onchange="updateFilteredCount()">
                                    <span class="chip-label">幻灯片 Slides</span>
                                </label>
                            </div>
                        </div>

                        <div class="flex justify-between items-center text-xs text-gray-500 pt-3 border-t border-gray-100 dark:border-gray-700">
                            <span>总库存: <span id="total-items-count">0</span></span>
                            <span id="filtered-count" class="text-pink-600 font-bold bg-pink-50 dark:bg-pink-900/30 px-3 py-1 rounded-full">选中 0 条</span>
                        </div>
                    </div>

                    <button
                        onclick="generateSummary()"
                        class="w-full py-4 bg-gradient-to-r from-pink-500 to-red-500 hover:from-pink-600 hover:to-red-600 text-white font-bold rounded-2xl shadow-lg hover:shadow-xl transition-all transform hover:scale-[1.01] flex justify-center items-center gap-2 group"
                    >
                        <span id="btn-text-summary">✨ 生成生活总结报告</span>
                        <div id="loading-spinner-summary" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    </button>
                </div>
            </div>

            <div id="summary-result-card" class="hidden bg-white dark:bg-gray-800 rounded-3xl shadow-xl p-8 border border-white/20 animate-fade-in relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-pink-200/30 to-blue-200/30 dark:from-pink-900/20 dark:to-blue-900/20 blur-3xl -z-10"></div>
                
                <div class="relative z-10">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
                            <span>📊</span> 分析报告
                        </h3>
                        <div class="flex gap-2">
                            <button onclick="copySummaryText()" class="text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 px-3 py-1.5 rounded-full hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors flex items-center gap-1" title="复制总结内容">
                                📋 复制
                            </button>
                            <button onclick="transferToPrompt()" class="text-xs font-bold text-white bg-black dark:bg-white dark:text-black px-4 py-1.5 rounded-full hover:opacity-80 transition-opacity shadow-lg flex items-center gap-1">
                                🎨 提取灵感
                            </button>
                        </div>
                    </div>
                    
                    <div id="stats-overview" class="grid grid-cols-3 gap-3 mb-6"></div>

                    <div class="prose dark:prose-invert max-w-none text-sm leading-7 text-gray-700 dark:text-gray-300 bg-white/50 dark:bg-black/20 p-5 rounded-2xl border border-white/50 dark:border-white/10 backdrop-blur-md shadow-sm">
                        <div id="ai-analysis-content"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-8">
            <div class="bg-white dark:bg-gray-800/80 backdrop-blur-xl rounded-3xl shadow-2xl p-8 border border-white/20">
                <div class="flex items-center gap-3 mb-6 border-b border-gray-100 dark:border-gray-700 pb-4">
                    <span class="text-2xl">🎨</span>
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                        封面生成室
                    </h2>
                </div>

                <div class="space-y-6">
                     <div class="p-5 bg-gray-50 dark:bg-black/30 rounded-2xl border border-gray-100 dark:border-gray-700">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">绘图 API (Z-Image/OpenAI)</h3>
                        <div class="space-y-3">
                            <div>
                                <input type="text" id="img-base-url" class="config-input text-xs" placeholder="Base URL (e.g. https://ai.gitee.com/v1)" value="https://ai.gitee.com/v1" />
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <input type="password" id="img-api-key" class="config-input text-xs" placeholder="API Key" />
                                <input type="text" id="img-model" class="config-input text-xs" placeholder="Model (z-image-turbo)" value="z-image-turbo" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                                画面描述 (Prompt)
                            </label>
                            <button 
                                onclick="optimizePrompt()"
                                class="text-xs bg-gradient-to-r from-red-500 to-pink-500 text-white px-3 py-1 rounded-full hover:shadow-md transition-all flex items-center gap-1"
                                title="生成 Apple Music 风格的中文 Prompt"
                            >
                                ✨ AI 润色 (音乐卡片风)
                            </button>
                        </div>
                        <textarea
                            id="img-prompt"
                            rows="4"
                            class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-2xl bg-gray-50 dark:bg-black/40 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-pink-500 text-sm resize-none shadow-inner font-mono"
                            placeholder="点击左侧 '提取灵感' 或上方 'AI 润色'..."
                        ></textarea>
                        
                        <div class="grid grid-cols-2 gap-4 mt-4">
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">宽度 (Width)</label>
                                <div class="flex items-center gap-2">
                                    <input type="number" id="img-width" value="1024" step="64" min="512" max="2048" class="w-full px-3 py-2 border rounded-xl dark:bg-gray-800 dark:border-gray-600 text-center font-mono text-sm" />
                                    <span class="text-xs text-gray-400">px</span>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">高度 (Height)</label>
                                <div class="flex items-center gap-2">
                                    <input type="number" id="img-height" value="1024" step="64" min="512" max="2048" class="w-full px-3 py-2 border rounded-xl dark:bg-gray-800 dark:border-gray-600 text-center font-mono text-sm" />
                                    <span class="text-xs text-gray-400">px</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 text-[10px] text-gray-400 flex justify-between">
                            <span>推荐: 1024x1024 (正方), 1024x1792 (手机), 1792x1024 (电脑)</span>
                            <div>
                                数量: <input type="number" id="img-num" value="1" min="1" max="4" class="w-10 text-center border rounded bg-transparent text-xs">
                            </div>
                        </div>
                    </div>

                    <button
                        onclick="handleGenerateImage()"
                        class="w-full py-4 bg-black dark:bg-white text-white dark:text-black font-bold rounded-2xl shadow-lg hover:shadow-xl transition-all transform hover:scale-[1.01] flex justify-center items-center gap-2"
                    >
                        <span id="btn-text-img">🎨 生成封面</span>
                        <div id="loading-spinner-img" class="hidden w-5 h-5 border-2 border-current border-t-transparent rounded-full animate-spin"></div>
                    </button>
                </div>
            </div>

            <div id="image-gallery" class="hidden grid grid-cols-1 gap-6 animate-fade-in"></div>
        </div>
      </div>

      <div id="toast" class="fixed bottom-10 left-1/2 transform -translate-x-1/2 hidden z-50 transition-all duration-300 translate-y-10 opacity-0">
         <div class="bg-gray-900/90 backdrop-blur text-white px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 border border-gray-700">
             <span id="toast-icon" class="text-xl">⚠️</span>
             <p id="toast-msg" class="text-sm font-medium">Message</p>
         </div>
      </div>
    </div>
  </div>

  <style>
      .config-input {
          @apply w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-pink-500 focus:outline-none transition-shadow;
      }
      .period-btn {
          @apply py-2 px-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-all;
      }
      .period-btn.active {
          @apply bg-pink-50 dark:bg-pink-900/30 border-pink-500 text-pink-600 dark:text-pink-300 shadow-inner;
      }
      /* 内容源 Checkbox 样式 */
      .content-type-cb:checked + .chip-label {
          @apply bg-gray-900 text-white dark:bg-white dark:text-black border-transparent;
      }
      .chip-label {
          @apply block px-3 py-1.5 rounded-full border border-gray-200 dark:border-gray-700 text-xs font-medium text-gray-500 dark:text-gray-400 cursor-pointer transition-all hover:border-gray-400;
      }
      
      @keyframes fadeIn {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in {
          animation: fadeIn 0.5s ease-out forwards;
      }
  </style>

  <script is:inline define:vars={{ serializedData }}>
    window.ALL_CONTENT_DATA = JSON.parse(serializedData);
  </script>

  <script is:inline>
    // --- 状态管理 ---
    const state = {
        summaryText: '',
        period: 'week'
    };

    // 初始化
    document.addEventListener('DOMContentLoaded', () => {
        // 恢复 API Key
        if(localStorage.getItem('llm_key')) document.getElementById('llm-api-key').value = localStorage.getItem('llm_key');
        if(localStorage.getItem('img_key')) document.getElementById('img-api-key').value = localStorage.getItem('img_key');
        
        document.getElementById('total-items-count').textContent = window.ALL_CONTENT_DATA.length;
        updateFilteredCount();
    });

    // --- 核心逻辑 ---

    // 1. 数据过滤逻辑升级：同时支持时间 + 内容类型
    function getFilteredData() {
        const now = new Date();
        let days = 7;
        
        // 时间过滤
        if (state.period === 'week') days = 7;
        else if (state.period === 'month') days = 30;
        else if (state.period === 'year') days = 365;
        else if (state.period === 'custom') days = parseInt(document.getElementById('n-days').value) || 7;

        const cutoffDate = new Date();
        cutoffDate.setDate(now.getDate() - days);

        // 类型过滤
        const selectedTypes = Array.from(document.querySelectorAll('.content-type-cb:checked')).map(cb => cb.value);

        return window.ALL_CONTENT_DATA.filter(item => {
            const dateMatch = new Date(item.date) >= cutoffDate;
            const typeMatch = selectedTypes.includes(item.type);
            return dateMatch && typeMatch;
        });
    }

    function updateFilteredCount() {
        const filtered = getFilteredData();
        const el = document.getElementById('filtered-count');
        el.textContent = `选中 ${filtered.length} 条`;
        
        if(filtered.length === 0) {
             el.className = "text-gray-400 font-medium bg-gray-100 px-3 py-1 rounded-full";
        } else {
             el.className = "text-pink-600 font-bold bg-pink-50 dark:bg-pink-900/30 px-3 py-1 rounded-full shadow-sm";
        }
    }

    // 2. 生成总结 (文案逻辑优化)
    async function generateSummary() {
        const apiKey = document.getElementById('llm-api-key').value;
        if (!apiKey) return showToast("请填写 AI API Key");
        localStorage.setItem('llm_key', apiKey);

        const filteredData = getFilteredData();
        if (filteredData.length === 0) return showToast("当前筛选条件下没有记录", "error");

        setLoading('summary', true);
        
        try {
            // 简单统计
            const stats = {
                count: filteredData.length,
                types: [...new Set(filteredData.map(i => i.typeLabel))].join(' & '),
                words: filteredData.reduce((acc, cur) => acc + (cur.wordCount || 0), 0)
            };

            // 渲染统计 UI
            document.getElementById('stats-overview').innerHTML = `
                <div class="p-3 bg-white/60 dark:bg-gray-700/30 rounded-2xl border border-gray-100 dark:border-gray-600 backdrop-blur-sm text-center">
                    <div class="text-xs text-gray-500 uppercase">回忆碎片</div>
                    <div class="text-xl font-bold text-gray-800 dark:text-gray-100">${stats.count}</div>
                </div>
                <div class="p-3 bg-white/60 dark:bg-gray-700/30 rounded-2xl border border-gray-100 dark:border-gray-600 backdrop-blur-sm text-center">
                    <div class="text-xs text-gray-500 uppercase">主要旋律</div>
                    <div class="text-sm font-bold text-gray-800 dark:text-gray-100 truncate">${stats.types}</div>
                </div>
                <div class="p-3 bg-white/60 dark:bg-gray-700/30 rounded-2xl border border-gray-100 dark:border-gray-600 backdrop-blur-sm text-center">
                    <div class="text-xs text-gray-500 uppercase">文字总量</div>
                    <div class="text-xl font-bold text-pink-500">${(stats.words/1000).toFixed(1)}k</div>
                </div>
            `;

            // 构建 Prompt
            const contentText = filteredData.map(i => `[${i.typeLabel}] ${i.title}: ${i.summary}`).join('\n').substring(0, 10000);

            const prompt = `你是一位Apple Music年度音乐回忆的文案策划。请根据用户的近期记录（${stats.types}）生成一份生活总结。
数据摘要：
${contentText}

要求：
1. **概念**：将生活比作一张精心编排的专辑。请定义这张专辑的“主打歌名”和“年度/月度风格”（如 #Lo-Fi治愈 #摇滚冲刺）。
2. **文案风格**：极简、深情、富有呼吸感，像 Apple Music 的专辑介绍文案。（例如：“在那些不被注意的清晨，你写下了...”）。
3. **金句**：提取一句“专辑扉页寄语”，简短有力。
4. **排版**：使用 Markdown，清晰分段，多用 Emoji (🎵, 💿, ✨)。
`;
            const text = await callLLM([{ role: 'user', content: prompt }]);
            state.summaryText = text;
            
            document.getElementById('ai-analysis-content').innerHTML = text.replace(/\n/g, '<br>');
            document.getElementById('summary-result-card').classList.remove('hidden');
            showToast("报告已生成", "success");

        } catch (e) {
            showToast(e.message);
        } finally {
            setLoading('summary', false);
        }
    }

    // 3. 提取灵感 -> 转为 Prompt
    async function transferToPrompt() {
        if (!state.summaryText) return showToast("请先生成总结");
        setLoading('summary', true); 
        try {
            const prompt = `基于以下生活总结，创作一个**中文绘图提示词**。
总结内容：${state.summaryText.substring(0, 500)}
目标风格：**Apple Music 歌词海报 (Lyrics Card Style)**。
视觉要求：
1. **背景**：高斯模糊 (Gaussian Blur) 的渐变背景，流动的色彩 (Fluid gradients)，色彩需提取自总结中的情绪（如温暖橙、忧郁蓝）。
2. **主体**：抽象的几何图形、黑胶唱片纹理 (Vinyl texture)、声波 (Waveform) 或极简的风景剪影。
3. **质感**：噪点 (Noise/Grain)，玻璃拟态 (Glassmorphism)，极简主义排版。
4. **输出**：直接输出一段高质量的**中文**画面描述，不要包含解释。`;

            const imgPrompt = await callLLM([{ role: 'user', content: prompt }]);
            document.getElementById('img-prompt').value = imgPrompt;
            showToast("灵感已提取", "success");
        } catch(e) { showToast(e.message); } 
        finally { setLoading('summary', false); }
    }

    // 4. AI 润色 (音乐卡片风 - 中文输出)
    async function optimizePrompt() {
        const rawInput = document.getElementById('img-prompt').value;
        if (!rawInput) return showToast("请先输入一些描述");

        try {
            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.innerHTML = '⏳ 润色中...';
            btn.disabled = true;

            const prompt = `你是一个 Midjourney/Stable Diffusion 提示词专家。请将以下描述重写为生成**“Apple Music 风格动态歌词背景”**的高质量**中文** Prompt。
原描述: ${rawInput}
优化要求：
1. 增加设计类关键词：Apple Music UI 风格, 动态模糊背景, 弥散光感, 极简排版, 专辑封面艺术.
2. 增加质感词：高斯模糊, 噪点质感, 4K 分辨率, 柔和光影.
3. 保持**中文**输出，描述具体画面。`;

            const refinedPrompt = await callLLM([{ role: 'user', content: prompt }]);
            document.getElementById('img-prompt').value = refinedPrompt;
            showToast("Prompt 润色完成", "success");

        } catch (e) {
            showToast(e.message);
        } finally {
            const btn = document.querySelector('button[title="生成 Apple Music 风格的中文 Prompt"]');
            if(btn) {
                btn.innerHTML = '✨ AI 润色 (音乐卡片风)';
                btn.disabled = false;
            }
        }
    }

    // 5. 生成图片 (修复 400 size 错误 - 使用 width/height)
    async function handleGenerateImage() {
        const apiKey = document.getElementById('img-api-key').value;
        if (!apiKey) return showToast("请填写绘图 API Key");
        localStorage.setItem('img_key', apiKey);
        
        const prompt = document.getElementById('img-prompt').value;
        if (!prompt) return showToast("请输入提示词");
        
        // 获取自定义宽高
        const width = parseInt(document.getElementById('img-width').value);
        const height = parseInt(document.getElementById('img-height').value);
        const num = parseInt(document.getElementById('img-num').value);

        setLoading('img', true);
        const gallery = document.getElementById('image-gallery');
        gallery.innerHTML = '';
        gallery.classList.remove('hidden');

        try {
            const baseUrl = document.getElementById('img-base-url').value.replace(/\/+$/, '');
            let url = baseUrl.includes('/generations') ? baseUrl : (baseUrl.endsWith('/v1') ? `${baseUrl}/images/generations` : `${baseUrl}/v1/images/generations`);

            console.log(`Sending request: width=${width}, height=${height}`);

            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${apiKey}` },
                // 关键修改：移除 size，使用 width 和 height
                body: JSON.stringify({ 
                    model: document.getElementById('img-model').value, 
                    prompt, 
                    n: num, 
                    width: width, 
                    height: height 
                })
            });

            if (!res.ok) {
                const errText = await res.text();
                throw new Error(errText);
            }
            
            const data = await res.json();
            
            (data.data || []).forEach((img, i) => {
                const src = img.url || `data:image/png;base64,${img.b64_json}`;
                const div = document.createElement('div');
                div.className = "relative group rounded-3xl overflow-hidden shadow-2xl aspect-auto bg-gray-900 ring-1 ring-white/10 transition-transform hover:scale-[1.02] duration-300";
                div.innerHTML = `
                    <img src="${src}" class="w-full h-auto object-cover" />
                    <div class="absolute bottom-0 inset-x-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex justify-between items-end">
                        <div class="text-white/90 text-xs font-mono backdrop-blur-md bg-white/10 px-3 py-1 rounded-full border border-white/20">
                            Apple Music Style
                        </div>
                        <a href="${src}" download="music-card-${Date.now()}-${i}.png" class="bg-white text-black px-4 py-2 rounded-full text-sm font-bold hover:bg-gray-200 transition-colors shadow-lg">
                            ⬇️ 下载
                        </a>
                    </div>
                `;
                gallery.appendChild(div);
            });
            showToast("封面生成成功", "success");
        } catch(e) {
            console.error(e);
            showToast("生成失败: " + e.message);
        } finally {
            setLoading('img', false);
        }
    }

    // --- 通用函数 ---
    function selectPeriod(p) {
        state.period = p;
        document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(`btn-${p}`).classList.add('active');
        const customInput = document.getElementById('custom-days-input');
        if (p === 'custom') customInput.classList.remove('hidden');
        else customInput.classList.add('hidden');
        updateFilteredCount();
    }

    function copySummaryText() {
        if (!state.summaryText) return showToast("暂无内容可复制");
        navigator.clipboard.writeText(state.summaryText).then(() => {
            showToast("复制成功！", "success");
        }).catch(() => {
            showToast("复制失败，请手动复制");
        });
    }

    function showToast(msg, type = 'error') {
        const toast = document.getElementById('toast');
        document.getElementById('toast-msg').innerText = msg;
        document.getElementById('toast-icon').innerText = type === 'success' ? '✅' : '⚠️';
        toast.classList.remove('hidden', 'translate-y-10', 'opacity-0');
        setTimeout(() => toast.classList.add('translate-y-10', 'opacity-0'), 4000);
    }

    function setLoading(id, loading) {
        const btn = document.getElementById(`loading-spinner-${id}`).parentElement;
        const spinner = document.getElementById(`loading-spinner-${id}`);
        const text = document.getElementById(`btn-text-${id}`);
        
        if (loading) {
            btn.disabled = true;
            spinner.classList.remove('hidden');
            text.style.opacity = '0.5';
        } else {
            btn.disabled = false;
            spinner.classList.add('hidden');
            text.style.opacity = '1';
        }
    }

    async function callLLM(messages) {
        const baseUrl = document.getElementById('llm-base-url').value.replace(/\/+$/, '');
        const apiKey = document.getElementById('llm-api-key').value;
        let url = baseUrl.includes('/chat/completions') ? baseUrl : (baseUrl.endsWith('/v1') ? `${baseUrl}/chat/completions` : `${baseUrl}/v1/chat/completions`);
        
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${apiKey}` },
            body: JSON.stringify({ model: document.getElementById('llm-model-name').value, messages })
        });
        if (!res.ok) throw new Error(await res.text());
        const data = await res.json();
        return data.choices[0].message.content;
    }
  </script>
</BaseLayout>