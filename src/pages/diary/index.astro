---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { generatePageSEO } from '@/utils/seo';
import { shouldShowContent, sortPostsByDate, extractTags } from '@/utils/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tags from '@/components/Tags.astro';
import Pagination from '@/components/Pagination.astro';
import Icon from '@/components/Icon.astro';
import DiaryCard from '@/components/DiaryCard.astro';

// Get all diary entries
const allDiaryEntries = await getCollection('diary');

// Filter entries based on environment
const isDev = import.meta.env.DEV;
const visibleEntries = allDiaryEntries.filter(entry => shouldShowContent(entry, isDev));

// Sort entries by date (newest first)
const sortedEntries = sortPostsByDate(visibleEntries);

// Pagination
const entriesPerPage = 10;
const totalEntries = sortedEntries.length;
const totalPages = Math.ceil(totalEntries / entriesPerPage);
const currentPage = 1; // This is the first page
const startIndex = 0;
const endIndex = Math.min(entriesPerPage, totalEntries);
const paginatedEntries = sortedEntries.slice(startIndex, endIndex);

// Extract all unique tags and moods
const allTags = extractTags(sortedEntries);
const allMoods = Array.from(new Set(sortedEntries.map(entry => entry.data.mood).filter(Boolean)));

// Generate SEO data
const pageTitle = 'Diary';
const pageDescription = `Personal diary entries, thoughts, and reflections. Total ${totalEntries} entries.`;

const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: pageDescription,
  canonical: Astro.url.href,
  ogType: 'website' as const
};

// Pagination info
const baseUrl = '/diary';
const pagination = {
  currentPage,
  totalPages,
  hasNext: currentPage < totalPages,
  hasPrev: false,
  nextUrl: totalPages > 1 ? '/diary/2' : undefined,
  prevUrl: undefined
};
---

<BaseLayout seoData={seoData}>
  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 mb-12" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-start justify-between mb-3">
          <h1 class="text-lg font-bold text-primary-900 dark:text-primary-50">
            {pageTitle}
          </h1>
          <div class="flex items-center space-x-2">
            <a
              href="/diary/rss.xml"
              class="inline-flex items-center px-3 py-2 text-sm font-medium text-highlight-600 dark:text-highlight-400 bg-highlight-50 dark:bg-highlight-900/20 rounded-lg border border-highlight-200 dark:border-highlight-700 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-700 dark:hover:text-highlight-300 transition-all duration-200"
              title="Subscribe to Diary RSS feed"
              data-no-swup
            >
              <Icon name="rss" class="w-4 h-4 mr-1.5" />
              RSS Feed
            </a>
          </div>
        </div>
        <p class="text-base text-primary-600 dark:text-primary-300">
          Personal diary entries, thoughts, and reflections. Total <strong>{totalEntries}</strong> entries.
        </p>

        <!-- Mood filter -->
        {allMoods.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="text-sm text-primary-500 dark:text-primary-400">Filter by mood:</span>
            {allMoods.map(mood => (
              <a
                href={`/diary?mood=${mood}`}
                class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700"
              >
                {mood}
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="relative">
        <!-- Main content -->
        <div class="max-w-none">
          {paginatedEntries.length > 0 ? (
            <>
              <!-- Diary entries list -->
              <div class="space-y-6 mb-12">
                {paginatedEntries.map((entry, index) => (
                  <DiaryCard entry={entry} eager={index < 2} />
                ))}
              </div>

              <!-- Pagination -->
              <Pagination pagination={pagination} baseUrl={baseUrl} />
            </>
          ) : (
            <!-- No diary entries -->
            <div class="text-center py-16">
              <Icon name="book-open" class="w-16 h-16 text-primary-400 dark:text-primary-500 mx-auto mb-6" />
              <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-50 mb-4">
                No diary entries yet
              </h2>
              <p class="text-primary-600 dark:text-primary-300 mb-8">
                Start writing your diary! Add entries to the <code>content/diary/</code> directory.
              </p>
              {isDev && (
                <div class="max-w-md mx-auto p-4 bg-blue-50 dark:bg-blue-950 rounded-lg border border-blue-200 dark:border-blue-800">
                  <p class="text-sm text-blue-800 dark:text-blue-200">
                    <strong>Dev Mode:</strong> Add some diary entries to the <code>content/diary/</code> directory to see them here.
                  </p>
                </div>
              )}
            </div>
          )}
        </div>

        <!-- Mobile sidebar - appears below content on mobile/tablet -->
        <div class="xl:hidden mt-12 space-y-6">
          <!-- Tags -->
          {allTags.length > 0 && (
            <Tags tags={allTags} />
          )}
        </div>

        <!-- Desktop sidebar - floats to the right of the content container -->
        <div class="hidden xl:block absolute top-0 left-full ml-8 w-64">
          <div class="sticky top-24 space-y-3 max-h-[calc(100vh-12rem)] overflow-y-auto pb-6">
            <!-- Tags -->
            {allTags.length > 0 && (
              <Tags tags={allTags} />
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Diary specific styles */
  .diary-entry {
    @apply border-l-4 border-highlight-500 pl-4;
  }
</style>
