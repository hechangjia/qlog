---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DiaryCard from '@/components/DiaryCard.astro';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const allEntries = await getCollection('diary');
  // 提取所有标签
  const uniqueTags = [...new Set(allEntries.flatMap(entry => entry.data.tags || []))];

  return uniqueTags.map(tag => {
    const filteredEntries = allEntries.filter(entry => 
      entry.data.tags && entry.data.tags.includes(tag)
    ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { tag, entries: filteredEntries }
    };
  });
}

const { tag, entries } = Astro.props;

const pageTitle = `日记标签: ${tag}`;
const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: `标签为 #${tag} 的日记列表`,
  canonical: Astro.url.href,
  ogType: 'website' as const
};
---

<BaseLayout seoData={seoData}>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <header class="mb-8">
      <a href="/diary" class="inline-flex items-center text-sm text-primary-600 hover:text-primary-800 mb-4 transition-colors">
        <Icon name="arrow-left" class="w-4 h-4 mr-1" />
        返回日记列表
      </a>
      <h1 class="text-2xl font-bold text-primary-900 dark:text-primary-50 flex items-center gap-2">
        <Icon name="tag" class="w-6 h-6 text-pink-500" />
        {pageTitle}
      </h1>
      <p class="mt-2 text-primary-600 dark:text-primary-400">
        共找到 {entries.length} 篇日记
      </p>
    </header>

    <div class="space-y-6">
      {entries.length > 0 ? (
        entries.map(entry => (
          /* 注意：这里使用 entry 属性，匹配你 DiaryCard 的定义 */
          <DiaryCard entry={entry} />
        ))
      ) : (
        <p class="text-center py-10 text-gray-500">该标签下暂无日记。</p>
      )}
    </div>
  </div>
</BaseLayout>