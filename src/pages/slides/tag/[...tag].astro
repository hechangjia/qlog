---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SlideCard from '@/components/SlideCard.astro';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const allSlides = await getCollection('slides');
  const uniqueTags = [...new Set(allSlides.flatMap(slide => slide.data.tags || []))];

  return uniqueTags.map(tag => {
    const filteredSlides = allSlides.filter(slide => 
      slide.data.tags && slide.data.tags.includes(tag)
    ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { tag, slides: filteredSlides }
    };
  });
}

const { tag, slides } = Astro.props;

const pageTitle = `演示标签: ${tag}`;
const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: `标签为 #${tag} 的幻灯片演示`,
  canonical: Astro.url.href,
  ogType: 'website' as const
};
---

<BaseLayout seoData={seoData}>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <header class="mb-8">
      <a href="/slides" class="inline-flex items-center text-sm text-primary-600 hover:text-primary-800 mb-4 transition-colors">
        <Icon name="arrow-left" class="w-4 h-4 mr-1" />
        返回演示列表
      </a>
      <h1 class="text-2xl font-bold text-primary-900 dark:text-primary-50 flex items-center gap-2">
        <Icon name="tag" class="w-6 h-6 text-orange-500" />
        {pageTitle}
      </h1>
      <p class="mt-2 text-primary-600 dark:text-primary-400">
        共找到 {slides.length} 个演示文稿
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {slides.length > 0 ? (
        slides.map(slide => (
          <SlideCard slide={slide} />
        ))
      ) : (
        <p class="col-span-full text-center py-10 text-gray-500">该标签下暂无演示。</p>
      )}
    </div>
  </div>
</BaseLayout>