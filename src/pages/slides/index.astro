---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { shouldShowContent, sortPostsByDate, extractTags } from '@/utils/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tags from '@/components/Tags.astro';
import Pagination from '@/components/Pagination.astro';
import Icon from '@/components/Icon.astro';
import SlideCard from '@/components/SlideCard.astro';

// Get all slides
const allSlides = await getCollection('slides');

// Filter slides based on environment
const isDev = import.meta.env.DEV;
const visibleSlides = allSlides.filter(slide => shouldShowContent(slide, isDev));

// Sort slides by date (newest first)
const sortedSlides = sortPostsByDate(visibleSlides);

// Filter by theme or tag if specified (Query Param Fallback)
const url = new URL(Astro.request.url);
const themeFilter = url.searchParams.get('theme');
const tagFilter = url.searchParams.get('tag');

const filteredSlides = sortedSlides.filter(slide => {
  if (themeFilter && slide.data.theme !== themeFilter) return false;
  if (tagFilter && (!slide.data.tags || !slide.data.tags.includes(tagFilter))) return false;
  return true;
});

// Pagination
const slidesPerPage = 12;
const totalSlides = filteredSlides.length;
const totalPages = Math.ceil(totalSlides / slidesPerPage);
const currentPage = 1;
const startIndex = 0;
const endIndex = Math.min(slidesPerPage, totalSlides);
const paginatedSlides = filteredSlides.slice(startIndex, endIndex);

// Extract all unique tags and themes
const allTags = extractTags(filteredSlides);
const allThemes = Array.from(new Set(filteredSlides.map(slide => slide.data.theme).filter(Boolean)));

// Generate SEO data
const pageTitle = 'Slides';
const pageDescription = `Interactive presentation slides using Reveal.js. Total ${totalSlides} presentations.`;

const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: pageDescription,
  canonical: Astro.url.href,
  ogType: 'website' as const
};

// Pagination info
const baseUrl = '/slides';
const pagination = {
  currentPage,
  totalPages,
  hasNext: currentPage < totalPages,
  hasPrev: false,
  nextUrl: totalPages > 1 ? '/slides/2' : undefined,
  prevUrl: undefined
};
---

<BaseLayout seoData={seoData}>
  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 mb-12" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <header class="mb-8">
        <div class="flex items-start justify-between mb-3">
          <h1 class="text-lg font-bold text-primary-900 dark:text-primary-50">
            📊 {pageTitle}
          </h1>
          <div class="flex items-center space-x-2">
            <a
              href="/slides/rss.xml"
              class="inline-flex items-center px-3 py-2 text-sm font-medium text-highlight-600 dark:text-highlight-400 bg-highlight-50 dark:bg-highlight-900/20 rounded-lg border border-highlight-200 dark:border-highlight-700 hover:bg-highlight-100 dark:hover:bg-highlight-900/40 hover:text-highlight-700 dark:hover:text-highlight-300 transition-all duration-200"
              title="Subscribe to Slides RSS feed"
              data-no-swup
            >
              <Icon name="rss" class="w-4 h-4 mr-1.5" />
              RSS Feed
            </a>
          </div>
        </div>
        <p class="text-base text-primary-600 dark:text-primary-300">
          {pageDescription} Using Reveal.js technology with keyboard navigation and speaker notes.
        </p>

        <div class="mt-4 flex flex-wrap gap-4">
          {allThemes.length > 0 && (
            <div>
              <span class="text-sm text-primary-500 dark:text-primary-400 mb-1 block">Theme:</span>
              <div class="flex flex-wrap gap-2">
                <a
                  href="/slides"
                  class={`inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full ${!themeFilter ? 'bg-highlight-100 dark:bg-highlight-900 text-highlight-800 dark:text-highlight-200' : 'bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700'}`}
                >
                  All
                </a>
                {allThemes.map(theme => (
                  <a
                    href={`/slides?theme=${theme}`}
                    class={`inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full ${themeFilter === theme ? 'bg-highlight-100 dark:bg-highlight-900 text-highlight-800 dark:text-highlight-200' : 'bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700'}`}
                  >
                    {theme}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </header>

      <div class="relative">
        <div class="max-w-none">
          {paginatedSlides.length > 0 ? (
            <>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
                {paginatedSlides.map((slide, index) => (
                  <SlideCard slide={slide} eager={index < 3} />
                ))}
              </div>

              <Pagination pagination={pagination} baseUrl={baseUrl} />
            </>
          ) : (
            <div class="text-center py-16">
              <Icon name="presentation" class="w-16 h-16 text-primary-400 dark:text-primary-500 mx-auto mb-6" />
              <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-50 mb-4">
                {themeFilter ? `No slides with theme "${themeFilter}"` :
                 tagFilter ? `No slides with tag "${tagFilter}"` :
                 'No slides yet'}
              </h2>
              <p class="text-primary-600 dark:text-primary-300 mb-8">
                {themeFilter || tagFilter ? 'Try different filters or create new slides.' :
                 'Start creating presentations! Add slides to the <code>content/slides/</code> directory in Obsidian.'}
              </p>
              {isDev && !themeFilter && !tagFilter && (
                <div class="max-w-md mx-auto p-4 bg-blue-50 dark:bg-blue-950 rounded-lg border border-blue-200 dark:border-blue-800">
                  <p class="text-sm text-blue-800 dark:text-blue-200">
                    <strong>Dev Mode:</strong> Add some slides to the <code>content/slides/</code> directory to see them here.
                  </p>
                </div>
              )}
            </div>
          )}
        </div>

        <div class="xl:hidden mt-12 space-y-6">
          {/* [修复] 添加 basePath 指向幻灯片标签页 */}
          {allTags.length > 0 && (
            <Tags tags={allTags} basePath="/slides/tag" />
          )}

          <div class="bg-white dark:bg-primary-800 rounded-xl shadow-lg p-6">
            <h2 class="text-xl font-bold text-primary-900 dark:text-primary-100 mb-4">
              💡 Usage Guide
            </h2>
            <div class="space-y-4">
              <div>
                <h3 class="text-sm font-semibold text-primary-800 dark:text-primary-200 mb-2">
                  ⌨️ Keyboard Shortcuts
                </h3>
                <ul class="space-y-1 text-xs text-primary-700 dark:text-primary-300">
                  <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">→</kbd> Next slide</li>
                  <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">←</kbd> Previous slide</li>
                  <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">F</kbd> Fullscreen</li>
                  <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">S</kbd> Speaker notes</li>
                  <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">Esc</kbd> Overview</li>
                </ul>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-primary-800 dark:text-primary-200 mb-2">
                  📝 Create in Obsidian
                </h3>
                <ol class="space-y-1 text-xs text-primary-700 dark:text-primary-300">
                  <li>1. Open <code>slides/</code> folder</li>
                  <li>2. Create new <code>.md</code> file</li>
                  <li>3. Use <code>---</code> to separate slides</li>
                  <li>4. Add frontmatter config</li>
                  <li>5. Save and sync</li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <div class="hidden xl:block absolute top-0 left-full ml-8 w-64">
          <div class="sticky top-24 space-y-3 max-h-[calc(100vh-12rem)] overflow-y-auto pb-6">
            {/* [修复] 添加 basePath 指向幻灯片标签页 */}
            {allTags.length > 0 && (
              <Tags tags={allTags} basePath="/slides/tag" />
            )}

            <div class="bg-white dark:bg-primary-800 rounded-xl shadow-lg p-6">
              <h2 class="text-xl font-bold text-primary-900 dark:text-primary-100 mb-4">
                💡 Usage Guide
              </h2>
              <div class="space-y-4">
                <div>
                  <h3 class="text-sm font-semibold text-primary-800 dark:text-primary-200 mb-2">
                    ⌨️ Keyboard Shortcuts
                  </h3>
                  <ul class="space-y-1 text-xs text-primary-700 dark:text-primary-300">
                    <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">→</kbd> Next slide</li>
                    <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">←</kbd> Previous slide</li>
                    <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">↑↓</kbd> Vertical nav</li>
                    <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">F</kbd> Fullscreen</li>
                    <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">S</kbd> Speaker notes</li>
                    <li><kbd class="px-2 py-1 bg-primary-100 dark:bg-primary-700 rounded">Esc</kbd> Overview</li>
                  </ul>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-primary-800 dark:text-primary-200 mb-2">
                    📝 Create in Obsidian
                  </h3>
                  <ol class="space-y-1 text-xs text-primary-700 dark:text-primary-300">
                    <li>1. Open <code>slides/</code> folder</li>
                    <li>2. Create new <code>.md</code> file</li>
                    <li>3. Use <code>---</code> to separate slides</li>
                    <li>4. Add frontmatter config</li>
                    <li>5. Save and sync</li>
                  </ol>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-primary-800 dark:text-primary-200 mb-2">
                    🎨 Available Themes
                  </h3>
                  <div class="flex flex-wrap gap-1 text-xs">
                    {['night', 'black', 'white', 'league', 'sky', 'beige'].map(theme => (
                      <span class="px-2 py-0.5 bg-primary-100 dark:bg-primary-700 rounded text-primary-700 dark:text-primary-300">{theme}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  kbd {
    display: inline-block;
    font-family: monospace;
    font-size: 0.9em;
  }

  code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.05);
  }

  .dark code {
    background: rgba(255, 255, 255, 0.1);
  }
</style>