---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TodoCard from '@/components/TodoCard.astro';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const allTodos = await getCollection('todo');
  const uniqueTags = [...new Set(allTodos.flatMap(todo => todo.data.tags || []))];

  return uniqueTags.map(tag => {
    const filteredTodos = allTodos.filter(todo => 
      todo.data.tags && todo.data.tags.includes(tag)
    ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { tag, todos: filteredTodos }
    };
  });
}

const { tag, todos } = Astro.props;

const pageTitle = `待办标签: ${tag}`;
const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: `标签为 #${tag} 的待办事项`,
  canonical: Astro.url.href,
  ogType: 'website' as const
};
---

<BaseLayout seoData={seoData}>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <header class="mb-8">
      <a href="/todo" class="inline-flex items-center text-sm text-primary-600 hover:text-primary-800 mb-4 transition-colors">
        <Icon name="arrow-left" class="w-4 h-4 mr-1" />
        返回待办列表
      </a>
      <h1 class="text-2xl font-bold text-primary-900 dark:text-primary-50 flex items-center gap-2">
        <Icon name="tag" class="w-6 h-6 text-blue-500" />
        {pageTitle}
      </h1>
      <p class="mt-2 text-primary-600 dark:text-primary-400">
        共找到 {todos.length} 个待办
      </p>
    </header>

    <div class="space-y-4">
      {todos.length > 0 ? (
        todos.map(todo => (
          <TodoCard todo={todo} />
        ))
      ) : (
        <p class="text-center py-10 text-gray-500">该标签下暂无待办。</p>
      )}
    </div>
  </div>
</BaseLayout>