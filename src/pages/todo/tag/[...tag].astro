---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TodoCard from '@/components/TodoCard.astro'; // 确保你有这个组件，或者使用适合 Todo 的展示组件
import Tags from '@/components/Tags.astro';
import Icon from '@/components/Icon.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allTodos = await getCollection('todo');
  
  // 提取所有标签
  const uniqueTags = [...new Set(allTodos.flatMap(todo => todo.data.tags || []))];

  return uniqueTags.map(tag => ({
    params: { tag },
    props: { tag, allTodos, allTags: uniqueTags }
  }));
};

const { tag, allTodos, allTags } = Astro.props;

// 过滤当前标签的 Todo
const filteredTodos = allTodos.filter(todo => 
  todo.data.tags && todo.data.tags.includes(tag)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageTitle = `待办标签: "${tag}"`;
const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: `标签为 ${tag} 的所有待办事项`,
  canonical: Astro.url.href,
  ogType: 'website' as const
};
---

<BaseLayout seoData={seoData}>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <header class="mb-8">
      <a href="/todo" class="inline-flex items-center text-sm text-primary-600 hover:text-primary-800 mb-4 transition-colors">
        <Icon name="arrow-left" class="w-4 h-4 mr-1" />
        返回待办列表
      </a>
      <h1 class="text-2xl font-bold text-primary-900 dark:text-primary-50 flex items-center gap-2">
        <Icon name="tag" class="w-6 h-6 text-highlight-600" />
        {pageTitle}
      </h1>
      <p class="mt-2 text-primary-600 dark:text-primary-400">
        共找到 {filteredTodos.length} 个相关待办
      </p>
    </header>

    <div class="grid gap-6">
      {filteredTodos.length > 0 ? (
        filteredTodos.map(todo => (
          /* 这里复用你的 TodoCard 组件 */
          <div class="p-4 rounded-lg border border-primary-200 dark:border-primary-700 bg-white dark:bg-primary-800 hover:shadow-md transition-shadow">
             <a href={`/todo/${todo.id}`} class="block group">
                <div class="flex justify-between items-start">
                    <h3 class="text-lg font-semibold group-hover:text-highlight-600 transition-colors">{todo.data.title}</h3>
                    <span class={`text-xs px-2 py-1 rounded-full ${todo.data.status === 'done' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}`}>
                        {todo.data.status}
                    </span>
                </div>
                <div class="mt-2 text-sm text-primary-600 line-clamp-2">{todo.data.description}</div>
                <div class="mt-3 flex items-center gap-4 text-xs text-primary-500">
                    <span>📅 {todo.data.date.toLocaleDateString()}</span>
                    {todo.data.priority && <span>🔥 {todo.data.priority}</span>}
                </div>
             </a>
          </div>
        ))
      ) : (
        <p>没有找到相关待办。</p>
      )}
    </div>
  </div>
</BaseLayout>
