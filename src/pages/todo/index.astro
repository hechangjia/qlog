---
import { getCollection, getEntry } from 'astro:content';
import { siteConfig } from '@/config';
import { generatePageSEO } from '@/utils/seo';
import { shouldShowContent, sortPostsByDate, extractTags } from '@/utils/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tags from '@/components/Tags.astro';
import Icon from '@/components/Icon.astro';
import TodoCard from '@/components/TodoCard.astro';
import DataviewResult from '@/components/DataviewResult.astro';
import { groupDataviewBlocks } from '@/utils/dataview-parser';

// --- 数据获取 ---
const allTodos = await getCollection('todo');

// 读取 Markdown 文件中的 Dataview 查询
const todoPage = await getEntry('special', 'todo');
let dataviewGroups: Record<string, any[]> = {};
if (todoPage && todoPage.body) {
  dataviewGroups = groupDataviewBlocks(todoPage.body);
}

// 过滤和排序 (仅过滤草稿)
const isDev = import.meta.env.DEV;
const visibleTodos = allTodos.filter(todo => shouldShowContent(todo, isDev));
const sortedTodos = sortPostsByDate(visibleTodos);

// --- 提取元数据 (用于生成筛选按钮) ---
const allTags = extractTags(sortedTodos);
const allStatuses = Array.from(new Set(sortedTodos.map(todo => todo.data.status).filter(Boolean)));
const allPriorities = Array.from(new Set(sortedTodos.map(todo => todo.data.priority).filter(Boolean)));
const allCategories = Array.from(new Set(sortedTodos.map(todo => todo.data.category).filter(Boolean)));

// SEO
const pageTitle = 'Todo List';
const pageDescription = `Personal task management system. Total ${sortedTodos.length} todos.`;
const seoData = {
  title: `${pageTitle} | ${siteConfig.title}`,
  description: pageDescription,
  canonical: Astro.url.href,
  ogType: 'website' as const
};
---

<BaseLayout seoData={seoData}>
  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 mb-12" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <header class="mb-8">
        <div class="flex items-start justify-between mb-3">
          <h1 class="text-lg font-bold text-primary-900 dark:text-primary-50">
            {pageTitle}
          </h1>
          <div class="flex items-center space-x-2">
            <a href="/todo/rss.xml" class="inline-flex items-center px-3 py-2 text-sm font-medium text-highlight-600 bg-highlight-50 rounded-lg border border-highlight-200 hover:bg-highlight-100 transition-all duration-200">
              <Icon name="rss" class="w-4 h-4 mr-1.5" /> RSS Feed
            </a>
          </div>
        </div>
        <p class="text-base text-primary-600 dark:text-primary-300">
          管理你的任务清单。共 <strong>{sortedTodos.length}</strong> 个任务。
          <span id="filtered-count-display" class="hidden ml-2 bg-highlight-100 text-highlight-800 px-2 py-0.5 rounded-full text-xs">
            筛选出 <span id="filtered-count">0</span> 个
          </span>
        </p>

        <div class="mt-4 flex flex-wrap gap-4" id="todo-filters">
          {allStatuses.length > 0 && (
            <div>
              <span class="text-sm text-primary-500 dark:text-primary-400 mb-1 block">Status:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/todo" data-filter-type="status" data-filter-value="all" class="filter-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors">
                  All
                </a>
                {allStatuses.map(status => (
                  <a href={`/todo?status=${status}`} data-filter-type="status" data-filter-value={status} class="filter-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors">
                    {status}
                  </a>
                ))}
              </div>
            </div>
          )}

          {allPriorities.length > 0 && (
            <div>
              <span class="text-sm text-primary-500 dark:text-primary-400 mb-1 block">Priority:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/todo" data-filter-type="priority" data-filter-value="all" class="filter-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors">
                  All
                </a>
                {allPriorities.map(priority => (
                  <a href={`/todo?priority=${priority}`} data-filter-type="priority" data-filter-value={priority} class="filter-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors">
                    {priority}
                  </a>
                ))}
              </div>
            </div>
          )}

          {allCategories.length > 0 && (
            <div>
              <span class="text-sm text-primary-500 dark:text-primary-400 mb-1 block">Category:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/todo" data-filter-type="category" data-filter-value="all" class="filter-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors">
                  All
                </a>
                {allCategories.map(category => (
                  <a href={`/todo?category=${category}`} data-filter-type="category" data-filter-value={category} class="filter-btn inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors">
                    {category}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </header>

      <div class="relative">
        <div class="max-w-none" id="todo-list-container">
          {sortedTodos.length > 0 ? (
            <div class="space-y-4 mb-12">
              {/* 渲染所有任务，让 JS 控制显示/隐藏 */}
              {sortedTodos.map((todo) => (
                <div 
                  class="todo-item-wrapper transition-all duration-300 ease-in-out"
                  data-status={todo.data.status}
                  data-priority={todo.data.priority}
                  data-category={todo.data.category}
                >
                  <TodoCard todo={todo} />
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-16">
              <Icon name="check-circle" class="w-16 h-16 text-primary-400 mx-auto mb-6" />
              <h2 class="text-2xl font-semibold text-primary-900 mb-4">没有找到任务</h2>
            </div>
          )}
          
          <div id="no-filter-results" class="hidden text-center py-16">
             <Icon name="search" class="w-16 h-16 text-primary-300 mx-auto mb-6" />
             <h2 class="text-xl font-medium text-primary-600">没有匹配筛选条件的任务</h2>
             <button id="clear-filters-btn" class="mt-4 px-4 py-2 bg-primary-100 hover:bg-primary-200 text-primary-700 rounded-lg text-sm transition-colors">
               清除筛选
             </button>
          </div>
        </div>

        <div class="xl:hidden mt-12 space-y-6">
          {allTags.length > 0 && <Tags tags={allTags} basePath="/todo/tag" />}
        </div>
        <div class="hidden xl:block absolute top-0 left-full ml-8 w-64">
          <div class="sticky top-24 space-y-3 max-h-[calc(100vh-12rem)] overflow-y-auto pb-6">
            {allTags.length > 0 && <Tags tags={allTags} basePath="/todo/tag" />}
          </div>
        </div>
      </div>
      
      {Object.keys(dataviewGroups).length > 0 && (
        <div class="mt-16 mb-12">
            <div class="bg-white dark:bg-primary-800 rounded-xl shadow-lg p-8 border border-primary-200 dark:border-primary-700">
                <div class="flex items-center gap-3 mb-6">
                    <Icon name="database" class="w-8 h-8 text-accent-600" />
                    <h2 class="text-2xl font-bold text-primary-900 dark:text-primary-100">
                      我的查询视图 (From Markdown)
                    </h2>
                </div>
                <div class="space-y-8">
                    {Object.entries(dataviewGroups).map(([groupName, blocks]) => (
                    <div class="space-y-4">
                        <h3 class="text-xl font-bold text-primary-800 dark:text-primary-200 border-l-4 border-accent-500 pl-3">
                            {groupName}
                        </h3>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            {blocks.map(block => (
                            <DataviewResult 
                                title={block.title} 
                                description={block.description} 
                                query={block.query} 
                                collections={{ todo: visibleTodos }} 
                            />
                            ))}
                        </div>
                    </div>
                    ))}
                </div>
            </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  // 客户端过滤脚本
  function initTodoFiltering() {
    const todoItems = document.querySelectorAll('.todo-item-wrapper');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const noResultsMsg = document.getElementById('no-filter-results');
    const filteredCountDisplay = document.getElementById('filtered-count-display');
    const filteredCountSpan = document.getElementById('filtered-count');
    const clearBtn = document.getElementById('clear-filters-btn');

    function applyFilters() {
      const urlParams = new URLSearchParams(window.location.search);
      const statusFilter = urlParams.get('status');
      const priorityFilter = urlParams.get('priority');
      const categoryFilter = urlParams.get('category');

      let visibleCount = 0;

      // 1. 过滤项目
      todoItems.forEach(item => {
        const el = item as HTMLElement;
        const status = el.dataset.status;
        const priority = el.dataset.priority;
        const category = el.dataset.category;

        let isVisible = true;
        if (statusFilter && status !== statusFilter) isVisible = false;
        if (priorityFilter && priority !== priorityFilter) isVisible = false;
        if (categoryFilter && category !== categoryFilter) isVisible = false;

        if (isVisible) {
          el.style.display = 'block';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      // 2. 更新空状态和计数
      if (visibleCount === 0) {
        noResultsMsg?.classList.remove('hidden');
      } else {
        noResultsMsg?.classList.add('hidden');
      }

      if (statusFilter || priorityFilter || categoryFilter) {
        filteredCountDisplay?.classList.remove('hidden');
        if (filteredCountSpan) filteredCountSpan.textContent = visibleCount.toString();
      } else {
        filteredCountDisplay?.classList.add('hidden');
      }

      // 3. 更新按钮样式
      filterBtns.forEach(btn => {
        const type = btn.getAttribute('data-filter-type');
        const value = btn.getAttribute('data-filter-value');
        
        let isActive = false;
        if (type === 'status') isActive = value === (statusFilter || 'all');
        if (type === 'priority') isActive = value === (priorityFilter || 'all');
        if (type === 'category') isActive = value === (categoryFilter || 'all');

        if (isActive) {
          btn.classList.add('bg-highlight-100', 'text-highlight-800', 'ring-2', 'ring-highlight-300');
          btn.classList.remove('bg-primary-100', 'text-primary-700', 'hover:bg-primary-200');
        } else {
          btn.classList.remove('bg-highlight-100', 'text-highlight-800', 'ring-2', 'ring-highlight-300');
          btn.classList.add('bg-primary-100', 'text-primary-700', 'hover:bg-primary-200');
        }
      });
    }

    // 监听 URL 变化 (前进/后退)
    window.addEventListener('popstate', applyFilters);

    // 拦截按钮点击，使用 pushState 避免刷新
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const href = (btn as HTMLAnchorElement).getAttribute('href');
        if (href) {
          // 构建新的 URL
          const targetUrl = new URL(href, window.location.origin);
          // 保留其他类型的参数 (例如点了 priority，保留 status)
          const currentParams = new URLSearchParams(window.location.search);
          const newParams = targetUrl.searchParams;
          
          // 合并参数逻辑
          const type = btn.getAttribute('data-filter-type');
          const value = btn.getAttribute('data-filter-value');
          
          if (value === 'all') {
            currentParams.delete(type!);
          } else {
            currentParams.set(type!, value!);
          }
          
          const newUrl = `${window.location.pathname}?${currentParams.toString()}`;
          window.history.pushState(null, '', newUrl);
          applyFilters();
        }
      });
    });

    if(clearBtn) {
      clearBtn.addEventListener('click', () => {
        window.history.pushState(null, '', window.location.pathname);
        applyFilters();
      });
    }

    // 初始化应用
    applyFilters();
  }

  // 支持 View Transitions (Astro/Swup)
  document.addEventListener('astro:page-load', initTodoFiltering);
  // 首次加载
  initTodoFiltering();
</script>