---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { shouldShowPost } from '@/utils/markdown';
import TodoLayout from '@/layouts/TodoLayout.astro';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  // Get all todo entries
  const todos = await getCollection('todo');

  // Filter todos for production (in dev, show all including drafts)
  const isDev = import.meta.env.DEV;
  const visibleTodos = todos.filter(todo => shouldShowPost(todo, isDev));

  // Generate paths
  return visibleTodos.map(todo => ({
    params: { slug: todo.id },
    props: { post: todo }
  }));
};

export interface Props {
  post: any;
}

const { post } = Astro.props;

// Validate todo data
if (!post) {
  return Astro.redirect('/404');
}

// Check if todo should be visible in production
const isDev = import.meta.env.DEV;
if (!shouldShowPost(post, isDev)) {
  return Astro.redirect('/404');
}
---

<TodoLayout todo={post} />
